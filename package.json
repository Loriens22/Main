{
  "name": "interstellar-beyond-endurance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interstellar: Beyond Endurance - a cinematic, scientifically grounded 3D space exploration simulator (fan project, Creative Mode).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/build-assets.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "5.9",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
