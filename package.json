{
  "name": "interstellar-beyond-endurance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unofficial fan-made 3D space exploration simulator inspired by Interstellar (2014).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:textures": "python3 tools/textures/build_textures.py",
    "assets:models": "python3 blender/build_all.py",
    "assets:optimize": "node tools/optimize_glb.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.6",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
