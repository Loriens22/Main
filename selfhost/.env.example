# Example of selfhost/.env. You do not need to create it: start.cmd / start.sh write it on the
# first run with random values and never overwrite it. Never commit the real file: anyone with
# the access code can connect a phone to your server.
ACCESS_CODE=MAV-XXXX-XXXX-XXXX
# Encrypts stored credentials (GitHub token, provider keys). Changing it means re-entering them.
SERVER_SECRET=replace-with-64-random-hex-characters
# Shared by the core and voice containers.
VOICE_SECRET=replace-with-48-random-hex-characters
