{
  "name": "Ornight Plus",
  "short_name": "Ornight",
  "id": "/ornight-plus/",
  "description": "A liquid-glass control surface for coding agents, built for mini tablets.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#05070f",
  "theme_color": "#05070f",
  "categories": ["developer", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/ornight-48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-72.png", "sizes": "72x72", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-167.png", "sizes": "167x167", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "icons/ornight-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
