      "src": "icons/ornight-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New thread",
      "short_name": "New",
      "description": "Start a new agent thread",
      "url": "./index.html?action=new-thread",
      "icons": [{ "src": "icons/ornight-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Changes",
      "short_name": "Changes",
      "description": "Open the review panel for the active thread",
      "url": "./index.html?panel=changes",
      "icons": [{ "src": "icons/ornight-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
